APP_NAME=S-RANK
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://rank-s.israelzamora.es
APP_TIMEZONE=Europe/Madrid

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=sync
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Symfony Mailer solo admite dos: «smtp» y «smtps». Ni «tls» ni «ssl» existen,
# y ponerlos revienta el envío con UnsupportedSchemeException.
#   puerto 587 -> smtp   (cifra con STARTTLS por su cuenta)
#   puerto 465 -> smtps
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=no-reply@israelzamora.es
MAIL_FROM_NAME=S-RANK
