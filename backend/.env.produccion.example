APP_NAME=S-RANK
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://s-rank.israelzamora.es
APP_TIMEZONE=Europe/Madrid

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=sync
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=mail.israelzamora.es
# Symfony Mailer solo admite dos esquemas: «smtp» y «smtps». Ni «tls» ni «ssl»
# existen, y ponerlos revienta el envío con UnsupportedSchemeException.
#   puerto 587 -> smtp   (cifra con STARTTLS por su cuenta)
#   puerto 465 -> smtps
# Los dos van juntos: si cambias uno, cambia el otro. Ginernet usa el 465.
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
# El remitente tiene que ser la MISMA cuenta que autentica en MAIL_USERNAME.
# Ginernet rechaza enviar en nombre de otra dirección, y ese fallo no se ve:
# forgot-password se traga la excepción del SMTP a propósito, para no delatar qué
# correos están registrados. Responde 200 igual y el error solo queda en el log.
# Producción usa soc@israelzamora.es en las dos.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=S-RANK
