# Sobrescribe la CSP que inyecta el hosting (Ginernet), que si no bloquea la aplicación.
#
# Esta lista era la de FitLoop: permitía scripts en línea y tres CDN porque aquella app
# los usaba. El frontend de React no usa ninguno —comprobado sobre el build: ni un script
# en línea, ni una sola referencia externa, ni eval— así que se cierra a 'self' y punto.
# Dejar 'unsafe-inline' en script-src es regalar la mitad de lo que una CSP sirve para
# evitar, y aquí dentro hay datos de salud y una sesión en cookie.
#
# ⚠️ Si algún día se añade una fuente, un icono o una librería de fuera, hay que abrirle
# hueco aquí o el navegador lo bloqueará sin decir nada visible en la interfaz.
<IfModule mod_headers.c>
    Header always unset Content-Security-Policy

    # img-src lleva blob: porque la vista previa de una foto antes de subirla se pinta
    # desde un objeto de la propia página (canvas → blob), no desde una URL del servidor.
    # Con 'self' a secas el hueco sale en blanco y NO hay ningún error visible en la
    # interfaz. En local no se ve: ahí no hay Apache que aplique esta cabecera.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' blob:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

    # Las fotos de alimentos y recetas las sube el usuario y se sirven desde este mismo
    # dominio, así que Apache no puede ponerse a adivinar el tipo de un fichero: si
    # decide que un .jpg es HTML, ese HTML se ejecuta con la sesión del usuario dentro.
    Header always set X-Content-Type-Options "nosniff"

    # La URL de una pantalla puede llevar datos dentro (/entrenos/482, /alimentos?q=...),
    # y a otro dominio no se le manda nada. Pero dentro de este sí, y tiene que ser así:
    #
    # ⚠️ «no-referrer» ROMPE EL LOGIN ENTERO. Sanctum decide si una petición viene del
    # frontend con `referer ?: origin` (EnsureFrontendRequestsAreStateful.php:75) y un GET
    # de fetch no manda Origin. Sin Referer no queda ninguno de los dos: la petición deja
    # de ser stateful, la cookie de sesión se ignora y /api/user contesta 401 con la sesión
    # recién abierta. Se probó en producción el 18 de agosto y así fue: login 200 y acto
    # seguido 401. «same-origin» manda el Referer completo aquí dentro y nada fuera.
    Header always set Referrer-Policy "same-origin"

    # Un año de HTTPS obligatorio. Sin «preload»: eso se pide en una lista externa, se
    # aplica al dominio entero y no se puede deshacer a tiempo si algo va mal.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # No hace falta X-Frame-Options: el «frame-ancestors 'none'» de arriba es su versión
    # moderna y lo entienden todos los navegadores que soportan esta CSP.
</IfModule>

# La raíz pasa siempre por Laravel, aunque haya un index.html al lado. Es lo que hace
# que «/» salga con Cache-Control: no-cache igual que el resto de rutas del frontend: si
# Apache sirviera el index.html en crudo, el navegador podría quedarse con uno viejo y
# seguir pidiendo un JavaScript que el despliegue nuevo ya no tiene.
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
