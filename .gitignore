# El bloque de Android y Gradle se fue con el esqueleto de Kotlin, que ya solo vive en la
# etiqueta android-fase-1.1 y lleva su propio .gitignore dentro.

# ── IDEs ──────────────────────────────────────────────────────────────────
.idea/
.vscode/
.fleet/
.nova/
.zed/
*.swp
*.swo

# ── PHP / Laravel (sin ancla: aplica a backend/ y a old/) ─────────────────
vendor/
node_modules/
deploy/
.env
.env.*
!.env.example
!.env.produccion.example
auth.json
.phpunit.result.cache
.phpunit.cache/
storage/framework/cache/
storage/framework/sessions/
storage/framework/views/
storage/logs/
storage/*.key
public/build/
public/hot/
public/storage/

# Datos personales de salud + hashes de contraseñas: nunca en git.
# El fichero sigue en disco (old/database/database.sqlite) — haz una copia
# fuera del proyecto antes de migrar a MySQL.
*.sqlite
*.sqlite-journal

# Los volcados de MySQL llevan lo mismo dentro: datos de salud y hashes.
*.sql

# ── Sistema ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log

# ── Local de esta máquina ─────────────────────────────────────────────────
.superpowers/
no_subir_referencias/

# Copia de lo que hay ahora mismo en el servidor. El .env de dentro ya lo cubre
# la regla de arriba, pero la carpeta entera va aquí para que nada de lo que se
# baje del FTP —logs, un volcado, lo que sea— pueda colarse por descuido.
nosubir_archivos_prod_actual/
